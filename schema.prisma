generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══ UTILISATEURS ═══

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  company        String?
  phone          String?
  passwordHash   String
  role           Role      @default(USER)
  plan           Plan      @default(VEILLE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  alerts         Alert[]
  savedSearches  SavedSearch[]
  favorites      Favorite[]
  sessions       Session[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  VEILLE
  MONTAGE
  STRATEGIE
}

// ═══ MARCHÉS PUBLICS ═══

model Marche {
  id              String    @id @default(cuid())
  reference       String?   @unique
  title           String
  description     String?   @db.Text
  buyer           String                    // Acheteur
  buyerSiret      String?
  department      String                    // Code département (01, 02... 2A, 2B...)
  region          String?
  nature          Nature                    // Travaux, Fournitures, Services
  type            MarcheType @default(APPEL_OFFRES)
  cpvCode         String?                   // Code CPV principal
  cpvLabel        String?
  estimatedValue  Float?                    // Montant estimé en €
  currency        String    @default("EUR")
  deadline        DateTime?                 // Date limite de réponse
  publicationDate DateTime                  // Date de publication
  source          String                    // BOAMP, PLACE, TED, etc.
  sourceUrl       String?   @db.Text        // Lien vers l'annonce originale
  status          MarcheStatus @default(OUVERT)
  lots            Int?                      // Nombre de lots
  duration        String?                   // Durée du marché

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  favorites       Favorite[]

  @@index([department])
  @@index([nature])
  @@index([publicationDate])
  @@index([deadline])
  @@index([cpvCode])
  @@index([source])
  @@index([status])
  @@map("marches")
}

enum Nature {
  TRAVAUX
  FOURNITURES
  SERVICES
}

enum MarcheType {
  APPEL_OFFRES
  PROCEDURE_ADAPTEE
  MARCHE_NEGOCIE
  DIALOGUE_COMPETITIF
  CONCESSION
  AUTRE
}

enum MarcheStatus {
  OUVERT
  FERME
  ATTRIBUE
  ANNULE
}

// ═══ ALERTES ═══

model Alert {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  active        Boolean   @default(true)
  frequency     AlertFreq @default(QUOTIDIEN)

  // Critères de filtrage
  keywords      String[]              // Mots-clés
  departments   String[]              // Départements ciblés
  natures       Nature[]              // Types de marchés
  cpvCodes      String[]              // Codes CPV
  minValue      Float?                // Montant min
  maxValue      Float?                // Montant max
  sources       String[]              // Sources spécifiques

  lastSentAt    DateTime?
  matchCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("alerts")
}

enum AlertFreq {
  IMMEDIAT
  QUOTIDIEN
  HEBDOMADAIRE
}

// ═══ RECHERCHES SAUVEGARDÉES ═══

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  filters     Json                // Filtres sauvegardés en JSON
  createdAt   DateTime @default(now())

  @@map("saved_searches")
}

// ═══ FAVORIS ═══

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marcheId  String
  marche    Marche   @relation(fields: [marcheId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, marcheId])
  @@map("favorites")
}
