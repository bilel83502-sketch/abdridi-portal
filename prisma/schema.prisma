generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  company      String?
  phone        String?
  siret        String?
  sector       String?
  passwordHash String?
  role         String   @default("USER")
  plan         String   @default("DECOUVERTE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?
  alerts       Alert[]
  appointments Appointment[]

  // Stripe
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
}

model Marche {
  id              String   @id @default(cuid())
  title           String
  buyer           String
  nature          String
  department      String
  departmentName  String?
  region          String?
  value           Float?
  deadline        DateTime?
  publicationDate DateTime?
  source          String
  sourceRef       String?   @unique
  procedureType   String?
  cpvCode         String?
  cpvLabel        String?
  lots            Int      @default(1)
  duration        String?
  status          String   @default("OUVERT")
  createdAt       DateTime @default(now())

  @@index([nature])
  @@index([department])
  @@index([status])
  @@index([publicationDate])
}

model MarcheAttribue {
  id                    String   @id @default(cuid())
  objet                 String
  acheteurNom           String
  acheteurSiret         String?
  titulaireNom          String
  titulaireSiret        String?
  titulaireCommune      String?
  montant               Float?
  dateNotification      DateTime?
  datePublicationDonnees DateTime?
  nature                String
  procedure             String?
  lieuExecution         String?
  departement           String?
  departementNom        String?
  region                String?
  codeCPV               String?
  labelCPV              String?
  source                String
  sourceRef             String   @unique
  dureeMois             Int?
  formePrix             String?
  createdAt             DateTime @default(now())

  @@index([titulaireNom])
  @@index([acheteurNom])
  @@index([nature])
  @@index([departement])
  @@index([dateNotification])
  @@index([montant])
}

model Entreprise {
  siren            String    @id
  raisonSociale    String
  formeJuridique   String?
  codeNaf          String?
  activite         String?
  effectifs        String?
  adresse          String?
  dateCreation     DateTime?
  statut           String?
  enrichiLe        DateTime  @default(now())

  @@index([raisonSociale])
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  keywords    String[]
  natures     String[]
  departments String[]
  frequency   String   @default("DAILY")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Appointment {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  marketReference String?
  requestedDate   DateTime
  timeSlot        String
  message         String?
  status          String     @default("PENDING")
  createdAt       DateTime   @default(now())
  relances        Relance[]

  @@index([userId])
  @@index([status])
  @@index([requestedDate])
}

model Relance {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  note          String
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}
