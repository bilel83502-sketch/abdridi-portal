generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  company       String?
  phone         String?
  siret         String?
  sector        String?
  passwordHash  String?
  emailVerified DateTime?
  role          String    @default("USER")
  plan          String    @default("DECOUVERTE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  lastNurturingEmail DateTime?
  alerts        Alert[]
  appointments  Appointment[]
  favoris       Favori[]

  // RGPD consent tracking
  consentDate          DateTime?
  consentIP            String?
  consentVersion       String?
  marketingConsent     Boolean   @default(false)
  marketingConsentDate DateTime?
  onboardingDismissed  Boolean   @default(false)

  // 2FA
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  backupCodes      String[]

  // Stripe
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CookieConsent {
  id        String   @id @default(cuid())
  userId    String?
  accepted  Boolean
  userAgent String?
  createdAt DateTime @default(now())
}

model Marche {
  id              String   @id @default(cuid())
  title           String
  buyer           String
  nature          String
  department      String
  departmentName  String?
  region          String?
  value           Float?
  deadline        DateTime?
  publicationDate DateTime?
  source          String
  sourceRef       String?   @unique
  procedureType   String?
  cpvCode         String?
  cpvLabel        String?
  lots            Int      @default(1)
  duration        String?
  documents       Json?    // [{name, url, type, size}]
  status          String   @default("OUVERT")
  createdAt       DateTime @default(now())
  missions        Mission[]

  @@index([nature])
  @@index([department])
  @@index([status])
  @@index([publicationDate])
  @@index([cpvCode])
}

model MarcheAttribue {
  id                    String   @id @default(cuid())
  objet                 String
  acheteurNom           String
  acheteurSiret         String?
  titulaireNom          String
  titulaireSiret        String?
  titulaireCommune      String?
  montant               Float?
  dateNotification      DateTime?
  datePublicationDonnees DateTime?
  nature                String
  procedure             String?
  lieuExecution         String?
  departement           String?
  departementNom        String?
  region                String?
  codeCPV               String?
  labelCPV              String?
  source                String
  sourceRef             String   @unique
  dureeMois             Int?
  formePrix             String?
  createdAt             DateTime @default(now())

  @@index([titulaireNom])
  @@index([acheteurNom])
  @@index([nature])
  @@index([departement])
  @@index([dateNotification])
  @@index([montant])
  @@index([titulaireSiret])
  @@index([objet])
}

model Entreprise {
  siren            String    @id
  raisonSociale    String
  formeJuridique   String?
  codeNaf          String?
  activite         String?
  effectifs        String?
  adresse          String?
  dateCreation     DateTime?
  statut           String?
  enrichiLe        DateTime  @default(now())

  @@index([raisonSociale])
}

model Favori {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marcheId  String
  createdAt DateTime @default(now())

  @@unique([userId, marcheId])
  @@index([userId])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  keywords    String[]
  natures     String[]
  departments String[]
  frequency   String    @default("DAILY")
  active         Boolean   @default(true)
  isDefault      Boolean   @default(false)
  lastSentAt     DateTime?
  lastMatchCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([active])
}

model Appointment {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  marketReference String?
  requestedDate   DateTime
  timeSlot        String
  message         String?
  status          String     @default("PENDING")
  createdAt       DateTime   @default(now())
  relances        Relance[]

  @@index([userId])
  @@index([status])
  @@index([requestedDate])
}

model Relance {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  note          String
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

// ─── Pilotage / Prospection ───

model Mission {
  id             String     @id @default(cuid())
  name           String
  aoReference    String?
  aoTitle        String?
  deadline       DateTime?
  ficheRecapUrl  String?
  ficheRecapName String?
  status         String     @default("ACTIVE")
  marcheId       String?
  marche         Marche?    @relation(fields: [marcheId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  prospects      Prospect[]
  documents      MissionDocument[]

  @@index([status])
  @@index([marcheId])
}

model MissionDocument {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("AUTRE")
  url       String
  mimeType  String?
  size      Int?
  fileData  String?
  createdAt DateTime @default(now())

  @@index([missionId])
}

model Prospect {
  id            String             @id @default(cuid())
  missionId     String
  mission       Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  company       String
  contact       String?
  phone         String?
  email         String?
  status        String             @default("A_CONTACTER")
  note          String?
  rdvDate       DateTime?
  devisAmount   Float?
  lastContactAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  activities    ProspectActivity[]

  @@index([missionId])
  @@index([status])
  @@index([missionId, status])
}

model ProspectActivity {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  action     String
  result     String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([prospectId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([result, createdAt])
}

model CronLog {
  id              String   @id @default(cuid())
  jobName         String
  executedAt      DateTime @default(now())
  success         Boolean
  message         String?
  alertsProcessed Int      @default(0)
  emailsSent      Int      @default(0)

  @@index([jobName])
  @@index([executedAt])
}

model StripeEventLog {
  id             String   @id @default(cuid())
  stripeEventId  String   @unique
  eventType      String
  processedAt    DateTime @default(now())
  success        Boolean  @default(true)
  errorMessage   String?

  @@index([eventType])
  @@index([processedAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  userEmail    String?
  userRole     String?
  action       String
  resource     String?
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  success      Boolean  @default(true)
  country      String?
  city         String?
  deviceType   String?
  browserName  String?
  osName       String?
  requestPath  String?
  responseTime Int?
  statusCode   Int?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([resource, resourceId])
  @@index([country])
  @@index([success])
}
