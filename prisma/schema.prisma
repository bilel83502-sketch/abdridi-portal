generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  company      String?
  phone        String?
  siret        String?
  sector       String?
  passwordHash String
  role         String   @default("USER")
  plan         String   @default("VEILLE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  alerts       Alert[]
}

model Marche {
  id              String   @id @default(cuid())
  title           String
  buyer           String
  nature          String
  department      String
  departmentName  String?
  region          String?
  value           Float?
  deadline        DateTime?
  publicationDate DateTime?
  source          String
  sourceRef       String?   @unique
  procedureType   String?
  cpvCode         String?
  cpvLabel        String?
  lots            Int      @default(1)
  duration        String?
  status          String   @default("OUVERT")
  createdAt       DateTime @default(now())

  @@index([nature])
  @@index([department])
  @@index([status])
  @@index([publicationDate])
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  keywords    String[]
  natures     String[]
  departments String[]
  frequency   String   @default("DAILY")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
