# ═══ BASE DE DONNÉES ═══
# Créer une base PostgreSQL gratuite sur https://neon.tech ou https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/abdridi_portail?sslmode=require"

# ═══ NEXTAUTH ═══
# Générer avec: openssl rand -base64 32
NEXTAUTH_SECRET="votre-secret-ici"
NEXTAUTH_URL="http://localhost:3000"

# ═══ EMAILS (optionnel) ═══
# Créer un compte sur https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxx"

# ═══ APP ═══
NEXT_PUBLIC_APP_NAME="AB DRIDI"
NEXT_PUBLIC_APP_URL="https://portail.abdridi.com"
